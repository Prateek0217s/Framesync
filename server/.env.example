# ---- FrameSync API environment ----
# Default matches the committed client dev proxy (client/vite.config.js).
PORT=5001

# MongoDB (Atlas or local). The DB name here is `framesync`.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/framesync?retryWrites=true&w=majority

# 7-day JWT signing secret — change this in production.
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ---- Object storage (AWS S3 or S3-compatible MinIO) ----
# STORAGE_MODE selects the backend: "s3" (default, production) or "local"
# (disk-backed dev mode — media streams through the API and lands in
# server/storage/, which sits on your SSD; override the folder with
# LOCAL_STORAGE_DIR). No AWS credentials needed in local mode.
STORAGE_MODE=s3
LOCAL_STORAGE_DIR=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=framesync-media

# Local MinIO dev (leave blank for real AWS S3):
#   S3_ENDPOINT=http://localhost:9000
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Frontend origin (CORS + magic-link URLs).
CLIENT_URL=http://localhost:5173

# ---- Google sign-in (Google Identity Services, PDD: agency login) ----
# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client ID
# -> Web application). The same value goes in client/.env as
# VITE_GOOGLE_CLIENT_ID — the browser gets the ID token, this server verifies
# its audience against this value. Add the app origin (http://localhost:5173 in
# dev) to the client's "Authorised JavaScript origins". Leave blank to disable
# Google sign-in — POST /api/auth/google then answers 503.
GOOGLE_CLIENT_ID=

# ---- Email notifications (Nodemailer, PDD Phase 7) ----
# SMTP relay used for the automated event emails (magic review link to the
# client, new client feedback + digital sign-off to the agency admins).
# Leave SMTP_HOST blank to disable — notifications are then logged, not sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, plus an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FrameSync <no-reply@framesync.app>"

# Number of trusted reverse-proxy hops in front of the API (e.g. 1 behind an
# nginx/ELB). Controls which X-Forwarded-For IP is trusted for the immutable
# approval audit (PDD §5.5.2). Leave blank/0 when the API is directly exposed —
# trusting a forwarded IP that no proxy sets would let clients spoof it.
TRUST_PROXY=
