{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://framesync-api-jmmk.onrender.com/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://framesync-api-jmmk.onrender.com/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
